// ── PHASE 42 — NETWORKING & REFERRALS ───────────────────────────────────────

enum ContactPipelineState {
  DISCOVERED
  TO_CONTACT
  CONTACTED
  CONVERSATION_ACTIVE
  FOLLOW_UP
  RELATIONSHIP_MAINTAINED
  REFERRAL_DISCUSSED
  ARCHIVED
}

enum RelationshipInteractionType {
  CONTACT_ADDED
  OUTREACH_DRAFTED
  OUTREACH_SENT
  CONVERSATION_NOTE
  FOLLOW_UP_SCHEDULED
  ADVICE_RECEIVED
  REFERRAL_DISCUSSED
  OUTCOME_RECORDED
}

enum NetworkingGoalType {
  LEARN_ROLE
  UNDERSTAND_COMPANY
  GET_ADVICE
  DISCUSS_SKILLS
  EXPLORE_INTERNSHIP
  BUILD_RELATIONSHIP
  PREPARE_APPLICATION
  REQUEST_REFERRAL
}

enum NetworkingGoalStatus {
  PENDING
  COMPLETED
  ABANDONED
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  SNOOZED
  CANCELLED
}

model ProfessionalContact {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String               @db.Uuid
  name             String               @db.VarChar(255)
  role             String               @db.VarChar(255)
  company          String?              @db.VarChar(255)
  industry         String?              @db.VarChar(255)
  skills           String[]             @default([])
  education        String?              @db.VarChar(255)
  connectionSource String?              @db.VarChar(255)
  publicProfileUrl String?              @db.VarChar(500)
  privateNotes     String?              @db.Text
  pipelineState    ContactPipelineState @default(DISCOVERED)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  interactions     RelationshipInteraction[]
  networkingGoals  NetworkingGoal[]
  outreachDrafts   OutreachDraft[]
  followUps        FollowUpMetadata[]

  @@index([userId])
  @@index([pipelineState])
  @@map("professional_contacts")
}

model RelationshipInteraction {
  id          String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contactId   String                      @db.Uuid
  type        RelationshipInteractionType @default(CONVERSATION_NOTE)
  description String                      @db.Text
  occurredAt  DateTime                    @default(now())

  contact     ProfessionalContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@map("relationship_interactions")
