  CLICKED
  REGISTERED
  ACTIVATED
  QUALIFIED
  REWARDED
  REJECTED
  FLAGGED
}

model ReferralCampaign {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String    @db.VarChar(100)
  description      String?   @db.Text
  isActive         Boolean   @default(true)
  rewardRulesJson  Json // E.g., { referrerReward: { type: 'PREMIUM_TRIAL', days: 7 }, refereeReward: { type: 'PREMIUM_TRIAL', days: 7 } }
