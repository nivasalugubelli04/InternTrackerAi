  componentName String   @db.VarChar(100)
  status        String   @db.VarChar(20)
  latency       Float    @default(0.0)
  errorRate     Float    @default(0.0)
  failureCount  Int      @default(0)
  metadata      Json?
  timestamp     DateTime @default(now())

  @@index([componentName])
  @@index([timestamp])
  @@map("health_snapshots")
}

model Incident {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                 String          @db.VarChar(255)
  severity              String          @db.VarChar(20) // P0, P1, P2, P3
  status                String          @default("DETECTED") @db.VarChar(30) // DETECTED, INVESTIGATING, MITIGATING, RESOLVED, CLOSED, FALSE_POSITIVE
  component             String          @db.VarChar(100)
  description           String          @db.Text
  firstDetectedAt       DateTime        @default(now())
  lastUpdatedAt         DateTime        @updatedAt
  resolvedAt            DateTime?
  rootCause             String?         @db.Text
  resolution            String?         @db.Text
  affectedUsers         Int             @default(0)
  affectedOrganizations Int             @default(0)
  affectedCompanies     Int             @default(0)

  @@index([status])
  @@index([severity])
  @@map("incidents")
}

model IncidentEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
