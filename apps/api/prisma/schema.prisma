  type       NetworkingGoalType   @default(BUILD_RELATIONSHIP)
  status     NetworkingGoalStatus @default(PENDING)
  targetDate DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  contact    ProfessionalContact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@map("networking_goals")
}

model OutreachDraft {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contactId       String              @db.Uuid
  userId          String              @db.Uuid
  goal            String              @db.VarChar(255)
  subject         String?             @db.VarChar(255)
  body            String              @db.Text
  personalization Json?
  factsReferenced String[]            @default([])
