
// =============================================================================
// Phase 15 — Monetization, Subscriptions, Premium Features & Billing
// =============================================================================

enum BillingInterval {
  MONTHLY
  YEARLY
  LIFETIME
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
  EXPIRED
  PAYMENT_FAILED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
}

model SubscriptionPlan {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String          @db.VarChar(100)
  slug            String          @unique @db.VarChar(100)
  description     String?         @db.Text
  billingInterval BillingInterval
  price           Decimal         @db.Decimal(10, 2)
  currency        String          @default("INR") @db.VarChar(10)
  isActive        Boolean         @default(true)
  featuresJson    Json?           // Array of string features
  limitsJson      Json?           // Key-value mapping of feature limits
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  subscriptions   Subscription[]
}

model Subscription {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String             @db.Uuid // Usually 1:1 active per user
  planId                 String             @db.Uuid
  provider               String             @db.VarChar(50) // e.g. "RAZORPAY"
  providerSubscriptionId String             @unique @db.VarChar(100)
  status                 SubscriptionStatus
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  cancelledAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                   SubscriptionPlan   @relation(fields: [planId], references: [id])
  payments               Payment[]
  invoices               Invoice[]

  @@index([userId])
  @@index([status])
}

model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String        @db.Uuid
  subscriptionId    String?       @db.Uuid
  provider          String        @db.VarChar(50)
  providerPaymentId String        @unique @db.VarChar(100)
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR") @db.VarChar(10)
  status            PaymentStatus
  paymentMethod     String?       @db.VarChar(100)
  failureReason     String?       @db.Text
  createdAt         DateTime      @default(now())

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Invoice {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String        @db.Uuid
  subscriptionId    String        @db.Uuid
  providerInvoiceId String        @unique @db.VarChar(100)
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR") @db.VarChar(10)
  status            String        @db.VarChar(50)
  invoiceUrl        String?       @db.Text
  createdAt         DateTime      @default(now())

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription      Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EntitlementUsage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @db.Uuid
  feature     String   @db.VarChar(100)
  usageCount  Int      @default(0)
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature, periodStart])
  @@index([userId])
}

model WebhookEvent {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    String        @db.VarChar(50)
  eventId     String        @unique @db.VarChar(100)
  eventType   String        @db.VarChar(100)
  payloadHash String        @db.VarChar(255)
  status      WebhookStatus @default(PENDING)
  processedAt DateTime?
  createdAt   DateTime      @default(now())

  @@index([status])
}
