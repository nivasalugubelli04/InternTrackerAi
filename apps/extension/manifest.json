{
  "manifest_version": 3,
  "name": "InternTracker AI Application Assistant",
  "version": "1.0.0",
  "description": "Auto-detects fields, drafts answer suggestions, and fills internship application forms.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
