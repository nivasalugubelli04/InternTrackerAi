# =============================================================================
# InternTracker AI – Git Attributes
# Ensures consistent line endings across platforms
# =============================================================================

# Default: normalize all text files to LF in the repository
* text=auto eol=lf

# Explicitly declare text files
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.env     text eol=lf
*.prisma  text eol=lf
*.sh      text eol=lf

# Windows-only files
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Binary files — do not modify
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.eot     binary
