{
  "name": "intern-tracker-ai",
  "version": "0.0.1",
  "private": true,
  "description": "InternTracker AI – mobile-first internship monitoring platform (monorepo root)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api": "npm run --workspace=apps/api",
    "mobile": "npm run --workspace=apps/mobile",
    "lint": "eslint \"apps/api/src/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"apps/api/src/**/*.ts\" --fix",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,json}\" \"*.{json,md}\"",
    "prepare": "husky",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
