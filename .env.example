# =============================================================================
# InternTracker AI – Environment Variables Example
# Copy this file to apps/api/.env and fill in your values.
# NEVER commit the actual .env file to version control.
#
# ENVIRONMENT MANAGEMENT:
# - **Development**: Use local `.env` and `docker-compose.yml` (Local DB/Redis).
# - **Testing**: Uses in-memory or ephemeral databases spun up via CI.
# - **Staging**: Must use isolated RDS, ElastiCache, and S3 resources from Production.
# - **Production**: Do NOT use `.env` files. Variables must be injected via 
#   AWS Secrets Manager and ECS Task Definitions.
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3000
APP_NAME=InternTrackerAPI
API_PREFIX=api/v1

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=intern_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=intern_tracker_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=true

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_64_CHAR_SECRET
JWT_REFRESH_SECRET=CHANGE_THIS_TO_A_DIFFERENT_STRONG_RANDOM_64_CHAR_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
# Use Mailtrap for local dev: https://mailtrap.io
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_mailtrap_user
EMAIL_PASSWORD=your_mailtrap_password
EMAIL_FROM=noreply@interntracker.ai

# URL of the frontend app (used in email links)
FRONTEND_URL=http://localhost:8081

# ─── Security ──────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# ─── AI Career Copilot (Phase 7) ───────────────────────────────────────────────
AI_ENABLED=true
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
AI_API_KEY=your_llm_provider_api_key_here
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.3
AI_TIMEOUT=30000

# Feature Flags
AI_CHAT_ENABLED=true
AI_RESUME_ANALYSIS_ENABLED=true
AI_COVER_LETTER_ENABLED=true
AI_INTERVIEW_ENABLED=true
AI_ROADMAP_ENABLED=true

# Custom Rate Limits
AI_RATE_LIMIT_CHAT_PER_HOUR=30
AI_RATE_LIMIT_RESUME_PER_DAY=3
AI_RATE_LIMIT_COVER_LETTER_PER_DAY=10
AI_RATE_LIMIT_INTERVIEW_PER_DAY=10
