# =============================================================================
# InternTracker AI – Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3000
APP_NAME=InternTrackerAPI
API_PREFIX=api/v1

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
# Used by Prisma and Docker Compose
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=intern_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=intern_tracker_db

# Prisma Database URL (constructed from the above)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── Logging ───────────────────────────────────────────────────────────────────
# Options: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Options: true | false — pretty-prints logs in development
LOG_PRETTY=true

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
